{
  "manifest_version": 3,
  "name": "yt-dlp Quick Download",
  "version": "1.3",
  "description": "Send the current tab, or any link, to the yt-dlp GUI app",
  "browser_specific_settings": {
    "gecko": {
      "id": "ytdlp-gui@dotcomaki.dev",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "action": {
    "default_title": "Send to yt-dlp",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "Open the yt-dlp popup for this tab"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
